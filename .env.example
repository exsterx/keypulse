# ============================================================
# Telegram Keyword Monitor — configuration
# Copy this file to ".env" and fill in the values.
# NEVER commit the real .env, session file or database to git.
# ============================================================

# ----- Telegram user account (GramJS / MTProto) -----
# Get these at https://my.telegram.org -> "API development tools"
TG_API_ID=
TG_API_HASH=
# Optional. A saved session string. Usually you can leave this empty and let
# `npm run auth` write the session (encrypted with Windows DPAPI) into
# data/session.bin (preferred). A session gives FULL access to your account.
TG_SESSION=

# ----- Notifications recipient -----
# Derived automatically from the authorized Telegram account: a private chat
# with the bot has chat_id == user_id, so no explicit ID is required here.
# (You still need to press /start on the bot once so it can message you.)

# ----- General -----
# IANA timezone used for the daily digest and date formatting.
TIMEZONE=Europe/Moscow
# Daily digest time in HH:MM (24h) format, in TIMEZONE.
DIGEST_TIME=09:00
# live  = only new messages
# backfill = only scan history, then stay idle
# both  = scan history first, then keep monitoring live
MONITOR_MODE=live
# How many days of history to scan on startup / `/scan N` default.
BACKFILL_DAYS=7
# Maximum number of messages to scan per chat during backfill (safety limit).
BACKFILL_LIMIT=500
# Minimum interval (seconds) between automatic history scans at startup in "both"
# mode. Protects against excessive Telegram API calls on frequent restarts.
BACKFILL_MIN_INTERVAL_SECONDS=600
# Score history by meaning during the startup backfill as well. Off by default:
# the cross-encoder needs ~270 ms per (message, semantic key) pair on CPU, so a
# week of history across many chats takes hours. `/scan 7d deep` turns semantic
# matching on for a single manual run without changing this setting.
BACKFILL_SEMANTIC=false

# Minimum number of characters a message must have to be scored by the semantic
# cross-encoder. Shorter messages (emoji, "ок", "+") are skipped entirely.
SEMANTIC_MIN_TEXT_LENGTH=10

# ----- Relay (required: notifications go through a central relay server) -----
RELAY_URL=
RELAY_API_KEY=

# ----- Matching -----
# exact | substring | regex  (case-insensitive)
SEARCH_MODE=substring

# ----- Notifications -----
# each = send one notification per match
# batch = accumulate matches and send them combined every NOTIFICATION_BATCH_SECONDS
NOTIFICATION_MODE=each
NOTIFICATION_BATCH_SECONDS=300
# Rate limit: max notifications sent per minute (per chat target).
NOTIFICATION_MAX_PER_MINUTE=20

# ----- Logging -----
# error | warn | info | debug
LOG_LEVEL=info
